# 复制为 .env 手填,或直接跑 `make setup` 交互生成。.env 不入库(见 .gitignore)。
URL="http://<LAN-IP>:<port>/v1/chat/completions"   # 被测端点完整 chat/completions 路径
MODEL="<服务端注册的模型名>"
KEY="EMPTY"                                          # 网关 key;无则 EMPTY

# ── Tokenizer:二选一 ──
# online:填模型仓库 id,install/run 阶段自动拉 tokenizer 到 ./tok
TOKENIZER_MODE=online
TOKENIZER_ID="<org/model,如 deepseek-ai/DeepSeek-V3>"
TOKENIZER_SOURCE=modelscope        # modelscope | hf(hf 走 HF_ENDPOINT 镜像,默认 hf-mirror.com)
# offline:指定本机已有 tokenizer 目录(含 tokenizer.json / config.json)
#TOKENIZER_MODE=offline
#TOKENIZER_PATH="/abs/path/to/tok"

# ── 负载(可选,有默认)──
PARALLEL="4 8 16 32"       # 并发档
NUMBER="60 80 120 160"     # 每档请求数(与并发档逐元素配对)
ROUNDS=3                   # round1=冷缓存,其余=暖缓存
MIN_TOKENS=128
MAX_TOKENS=256
