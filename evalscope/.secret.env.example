# 复制为 .secret.env 后填入真实值(.secret.env 已被 gitignore,不会入库)
#   cp .secret.env.example .secret.env
export URL="http://<LAN-IP>:<port>/v1/chat/completions"   # 被测端点完整 chat/completions 路径
export MODEL="<服务端注册的模型名>"                          # 服务端注册的模型名
export KEY="EMPTY"                                          # 网关 key;无则 EMPTY
