# 复制为 config.env 手填,或直接跑 `make config` 交互生成。
# config.env 不入库(见 .gitignore);本文件是入库模板,不得含真实端点/密钥。

# ── 被测端点(OpenAI 兼容)──
URL="http://<LAN-IP>:<port>/v1/chat/completions"   # 完整 chat/completions 路径
MODEL="<服务端注册的模型名>"
KEY="EMPTY"                                          # 网关 key;无则 EMPTY

# ── Tokenizer(数 token 用,不是权重):二选一 ──
TOKENIZER_MODE=online
TOKENIZER_ID="<org/model,如 deepseek-ai/DeepSeek-V3>"
TOKENIZER_SOURCE=modelscope    # modelscope | hf(hf 走 HF_ENDPOINT,默认 hf-mirror.com)
#TOKENIZER_MODE=offline
#TOKENIZER_PATH="/abs/path/to/tok"

# ── 选模板(make run 按它自动填充所有压测参数)──
TEMPLATE=inference-baseline    # 可用模板见 templates/,或 make run TEMPLATE=xxx 临时切换

#IMG="ghcr.io/weetime/md-runner-evalscope:0afe9b07"   # 可选,有内置默认(须 ≥ #358)
