# ShareGPT 真实流量、short 口径,TTFT/TPOT 基线并发扫描
AXIS=parallel
DATASET=share_gpt_en
PARALLEL="4 8 16 32"      # 并发档
NUMBER="60 80 120 160"    # 每档请求数(与并发档逐元素配对)
MIN_TOKENS=128
MAX_TOKENS=256
ROUNDS=3                  # round1=冷缓存,其余=暖缓存
SEED=42
TTFT_SLO=1500            # p95 首 token 延迟阈值(ms)
ITL_SLO=200             # p95 出字间隔阈值(ms)
